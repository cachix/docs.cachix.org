---
import { Icon, Tabs, TabItem } from '@astrojs/starlight/components';
import { Code } from 'astro-expressive-code/components';
import Button from '@cachix/site-kit/ui/Button.astro';

const management = [
  { icon: 'code-branch' as const, title: 'Share dependencies', description: 'Share dependencies between caches with upstreams instead of uploading the same paths to each cache.', label: 'Configure upstreams', href: '/upstreams.html' },
  { icon: 'padlock' as const, title: 'Keep releases available', description: 'Protect a release and its dependencies from garbage collection with pins.', label: 'Create a pin', href: '/pins.html' },
  { icon: 'database' as const, title: 'Manage storage', description: 'Understand how garbage collection selects paths for removal and how pins protect builds you want to keep.', label: 'Understand garbage collection', href: '/garbage-collection.html' },
];
---

<div class="docs-overview not-content">
  <div class="intro">
    <p class="intro-lead">Share your project’s Nix builds with Cachix so other machines can download the results instead of building them again.</p>
    <a class="text-link" href="/what-is-a-binary-cache.html">How binary caches work <Icon name="right-arrow" /></a>
  </div>

  <section class="start" aria-labelledby="start-heading">
    <h2 id="start-heading">Start using Cachix</h2>
    <div class="start-card">
      <Tabs>
        <TabItem label="Push a build" icon="rocket">
          <div class="task-panel">
            <div class="task-copy">
              <h3>Push your project’s builds</h3>
              <p>Create a cache for your project and upload its build results. Other machines can then download those results from your cache.</p>
              <Button href="/getting-started.html" arrow>Make your first push</Button>
            </div>
            <div class="task-example">
              <Code code={'$ nix-build\n$ cachix push MY_CACHE ./result'} lang="console" wrap title="Project directory" />
              <div class="build-flow" role="img" aria-label="Upload the build result from your machine to your Cachix cache">
                <span><Icon name="laptop" /> Your machine</span><Icon name="right-arrow" />
                <span class="flow-cache"><Icon name="database" /> Cachix cache</span>
              </div>
            </div>
          </div>
        </TabItem>
        <TabItem label="Use an existing cache" icon="cloud-download">
          <div class="task-panel">
            <div class="task-copy">
              <h3>Use your team’s builds</h3>
              <p>Connect Nix to a cache your team already uses and download matching builds. You’ll need a token with read access if the cache is private.</p>
              <Button href="/using-a-cache.html" arrow>Use an existing cache</Button>
            </div>
            <div class="task-example">
              <Code code={'$ cachix use MY_CACHE\n$ nix-build'} lang="console" wrap title="Another machine" />
              <div class="build-flow" role="img" aria-label="Download the build result from the Cachix cache to your machine">
                <span class="flow-cache"><Icon name="database" /> Cachix cache</span><Icon name="right-arrow" />
                <span><Icon name="laptop" /> Your machine</span>
              </div>
            </div>
          </div>
        </TabItem>
      </Tabs>
    </div>
  </section>

  <section class="ci-panel" aria-labelledby="ci-heading">
    <div class="ci-copy">
      <h2 id="ci-heading">Cache builds in CI</h2>
      <p>Use Cachix in your CI workflow so later runs can download the results of earlier builds. Your team can use the same cache on their own machines. Replace <code>MY_CACHE</code> with your cache name.</p>
      <Button href="/continuous-integration-setup/github-actions.html" arrow>Set up cachix-action</Button>
      <a class="secondary-link" href="/continuous-integration-setup/index.html#choose-your-ci-platform">Browse CI guides <Icon name="right-arrow" /></a>
    </div>
    <div class="ci-example">
      <Code code={'- uses: cachix/cachix-action@v17\n  with:\n    name: MY_CACHE\n    authToken: "${{ secrets.CACHIX_AUTH_TOKEN }}"'} lang="yaml" wrap title="GitHub Actions step" />
    </div>
  </section>

  <section class="management" aria-labelledby="manage-heading">
    <h2 id="manage-heading">Manage your cache</h2>
    <p class="section-intro">As your cache grows, you can choose where dependencies come from and which builds to keep.</p>
    <div class="management-grid">
      {management.map((item) => (
        <a class="topic-card" href={item.href}>
          <span class="topic-icon"><Icon name={item.icon} size="1.4rem" /></span>
          <h3>{item.title}</h3>
          <p>{item.description}</p>
          <span class="card-link">{item.label} <Icon name="right-arrow" /></span>
        </a>
      ))}
    </div>
  </section>

  <section class="products" aria-labelledby="products-heading">
    <h2 id="products-heading">Deployments</h2>
    <a class="product-card" href="/deploy/index.html">
      <Icon name="rocket" size="1.5rem" />
      <div><h3>Cachix Deploy</h3><p>Deploy your builds to machines running Cachix agents.</p></div>
      <Icon name="right-arrow" size="1.5rem" />
    </a>
  </section>

  <div class="support">
    <span>Get help</span>
    <a href="/faq.html">FAQ</a>
    <a href="https://github.com/cachix/feedback/issues">Browse GitHub issues</a>
    <a href="https://app.cachix.org">Chat in the Cachix app</a>
    <a href="mailto:support@cachix.org">Email support</a>
  </div>
</div>

<style>
  :global(:root[data-has-sidebar]:has(.docs-overview)) { --sl-content-width: 68rem; }
  :global(html:has(.docs-overview) .content-panel + .content-panel) { border-top: 0; padding-top: 0; }
  :global(html:has(.docs-overview) h1) { font-size: clamp(2rem, 4vw, 3rem); letter-spacing: -0.045em; }
  .docs-overview { --overview-muted: #526075; color: #0c192f; }
  .docs-overview h2, .docs-overview h3, .docs-overview p { margin: 0; }
  .docs-overview h2 { font-size: 1.5rem; line-height: 1.25; letter-spacing: -0.035em; }
  .docs-overview h3 { font-size: 1.125rem; line-height: 1.3; letter-spacing: -0.025em; }
  .docs-overview p { color: var(--overview-muted); line-height: 1.65; }
  .docs-overview a { text-decoration: none; }
  .docs-overview a:focus-visible { outline: 2px solid #2856a0; outline-offset: 5px; }
  .intro { padding: 0 0 2.75rem; }
  .intro .intro-lead { max-width: 45rem; color: #526075; font-size: 1.125rem; }
  .text-link { display: inline-flex; gap: 0.4rem; align-items: center; color: #2856a0; font-weight: 600; margin-top: 1rem; font-size: 0.875rem; }
  .text-link:hover, .secondary-link:hover { text-decoration: underline; }
  .start > h2 { margin-bottom: 1.25rem; }
  .start-card { border: 1px solid #dbe2eb; border-radius: 0.75rem; overflow: hidden; }
  .start-card :global(.tablist-wrapper) { padding: 0.5rem 0.75rem; background: #f6f8fb; }
  .start-card :global([role='tablist']) { display: grid; grid-template-columns: 1fr 1fr; width: min(100%, 28rem); gap: 0.25rem; margin: 0; padding: 0.25rem; border: 1px solid #dbe2eb; border-radius: 0.625rem; background: #e9eef5; }
  .start-card :global(.tab) { min-width: 0; }
  .start-card :global(.tab > [role='tab']) { justify-content: center; width: 100%; padding: 0.5rem 0.75rem; border: 1px solid transparent; border-radius: 0.375rem; box-shadow: none; color: #526075; font-size: 0.875rem; text-align: center; white-space: normal; }
  .start-card :global([role='tab']:hover) { background: #f8faff; color: #2856a0; }
  .start-card :global([role='tab']:focus-visible) { outline: 2px solid #2856a0; outline-offset: -2px; }
  .start-card :global([role='tab'][aria-selected='true']) { border-color: #cbd5e3; background: #fff; color: #0c192f; box-shadow: 0 1px 3px #0c192f14; }
  .start-card :global(.tablist-wrapper ~ [role='tabpanel']) { margin: 0; padding: 0; }
  .task-panel { display: grid; grid-template-columns: 1fr 1.05fr; gap: 2rem; align-items: center; padding: 1.5rem; }
  .task-panel > *, .ci-panel > * { min-width: 0; }
  .task-copy h3 { margin: 0 0 0.75rem; font-size: 1.6rem; }
  .task-copy p { font-size: 0.9375rem; margin-bottom: 1.5rem; }
  .task-copy :global(.csk-button), .ci-copy :global(.csk-button) { font-size: 0.875rem; min-height: 2.75rem; max-width: 100%; white-space: normal; }
  .secondary-link { display: flex; align-items: center; gap: 0.4rem; width: fit-content; font-size: 0.8125rem; color: #526075; margin-top: 0.875rem; }
  .task-example { align-self: stretch; display: flex; flex-direction: column; justify-content: center; padding: 1.25rem; background: #f6f8fb; border-radius: 0.5rem; }
  .task-example :global(.expressive-code), .ci-example :global(.expressive-code) { min-width: 0; font-size: 0.8125rem; }
  .build-flow { display: flex; gap: 0.6rem; justify-content: center; align-items: center; margin-top: 1.5rem; color: #526075; font-size: 0.75rem; }
  .build-flow > span { display: flex; flex-direction: column; align-items: center; gap: 0.5rem; }
  .build-flow > :global(svg) { width: 1rem; flex-shrink: 0; }
  .build-flow span :global(svg) { width: 1.5rem; height: 1.5rem; }
  .build-flow .flow-cache { color: #2856a0; }
  .ci-panel { display: grid; grid-template-columns: 1fr 1.05fr; gap: 2rem; align-items: center; padding: 2rem; border: 1px solid #dbe2eb; border-radius: 0.75rem; background: #f4f7fc; margin-top: 2rem; }
  .ci-copy p { margin: 0.75rem 0 1.25rem; font-size: 0.9375rem; }
  .management, .products { margin-top: 3.5rem; }
  .docs-overview .section-intro { margin-top: 0.5rem; font-size: 0.9375rem; }
  .management-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); margin-top: 1.5rem; gap: 1rem; }
  .topic-card { display: flex; flex-direction: column; padding: 1.5rem; border: 1px solid #dbe2eb; border-radius: 0.65rem; color: inherit; }
  .topic-card:hover, .product-card:hover { border-color: #2856a0; background: #f8faff; }
  .topic-icon { display: flex; align-items: center; justify-content: center; background: #eff4fb; color: #2856a0; width: 2.5rem; height: 2.5rem; border-radius: 0.5rem; margin-bottom: 1.25rem; }
  .topic-card > p { font-size: 0.875rem; margin: 0.75rem 0 1.5rem; }
  .card-link { display: flex; gap: 0.4rem; align-items: center; color: #2856a0; font-weight: 600; font-size: 0.8125rem; margin-top: auto; }
  .card-link :global(svg) { flex-shrink: 0; }
  .product-card { display: flex; align-items: center; gap: 1rem; margin-top: 1.5rem; padding: 1.5rem; border: 1px solid #dbe2eb; border-radius: 0.65rem; color: inherit; }
  .product-card > :global(svg) { color: #2856a0; flex-shrink: 0; }
  .product-card > :global(svg:last-child) { margin-left: auto; }
  .product-card p { font-size: 0.8125rem; margin-top: 0.4rem; }
  .support { display: flex; flex-wrap: wrap; gap: 0.75rem 1.25rem; border-top: 1px solid #e5e7eb; margin-top: 3rem; padding-top: 1.5rem; font-size: 0.8125rem; }
  .support > span { color: #526075; }
  .support a { color: #2856a0; }
  .support a:hover { text-decoration: underline; }
  @media (max-width: 64rem) {
    .task-panel, .ci-panel { grid-template-columns: 1fr; }
    .management-grid { grid-template-columns: 1fr; }
    .topic-card { padding: 1.25rem; }
  }
  @media (max-width: 30rem) {
    .intro { padding-bottom: 2rem; }
    .task-panel, .ci-panel { padding: 1.25rem; gap: 1.5rem; }
    .start-card :global(.tablist-wrapper) { padding-inline: 0.75rem; }
    .start-card :global(.tab > [role='tab']) { font-size: 0.75rem; gap: 0.35rem; }
    .task-copy h3 { font-size: 1.375rem; }
    .task-example { padding: 0.75rem; }
    .product-card { padding: 1.25rem; gap: 0.75rem; }
  }
</style>
